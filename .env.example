# Copy the relevant lines into instructor-dashboard/.env (never commit .env).
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-SUPABASE-ANON-KEY

# The browser extension has no .env: put the same two PUBLIC values in
# browser-extension/config.js (SUPABASE_URL and SUPABASE_ANON_KEY).
#
# The service role key is injected into Edge Functions by Supabase automatically.
# Do NOT put it in the dashboard, the extension, or GitHub.
